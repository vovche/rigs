# Maintainer: vovche <vovche@users.noreply.github.com>
# Latest main branch (AUR: rigs-git). Local install from a clone: see docs/packaging.md.
pkgname=rigs-git
_pkgname=rigs
pkgver=0.9.0
pkgrel=1
pkgdesc='Native GNOME hub for virtual machines and containers (git main)'
arch=('x86_64' 'aarch64')
url='https://github.com/vovche/rigs'
license=('Apache-2.0')
depends=('glib2' 'gtk4' 'libadwaita' 'json-glib' 'libsoup3')
makedepends=('git' 'meson' 'vala' 'gettext')
optdepends=('podman: containers and Compose projects'
            'docker: containers and Compose projects'
            'docker-compose: Compose projects with Docker'
            'qemu-desktop: VMs started by your own QEMU script'
            'libvirt: libvirt domains (virsh)'
            'virt-viewer: consoles of libvirt domains and SPICE VMs'
            'remmina: RDP connections')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  arch-meson "$_pkgname" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
