rigs_sources = [
  'main.vala',
  'application.vala',
  'window.vala',
  'vm_card.vala',
  'sparkline.vala',
  'add_dialog.vala',
  'vm_model.vala',
  'monitor.vala',
  'guest_memory.vala',
  'guest_tools_dialog.vala',
  'host_command.vala',
  'resource_discovery.vala',
  'discovery_dialog.vala',
  'drivers/managed_driver.vala',
  'drivers/driver.vala',
  'drivers/qemu_driver.vala',
  'drivers/compose_driver.vala',
  'drivers/driver_registry.vala',
  'system_diagnostics.vala',
  'search_provider.vala',
  config_vala,
]

executable('rigs',
  rigs_sources,
  resources,
  dependencies: [
    gtk_dep,
    adw_dep,
    json_dep,
    glib_dep,
    gio_dep,
    gio_unix_dep,
    posix_dep,
    m_dep,
  ],
  install: true,
)
